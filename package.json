{
  "name": "numpredo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "numpredo — 日语数独/ナンプレ 内容站（Astro + 框架无关数独引擎）",
  "scripts": {
    "demo": "node scripts/demo.ts",
    "render-demo": "node scripts/render-demo.ts",
    "gen:pool": "node scripts/gen-pool.ts",
    "gen:sitemap": "node scripts/gen-sitemap-lastmod.ts",
    "gen:published": "node scripts/gen-published.ts",
    "gen:activity-pack": "python3 scripts/gen-activity-pack.py",
    "gen:print-pdfs": "python3 scripts/gen-print-pdfs.py",
    "submit:indexnow": "node scripts/submit-indexnow.ts",
    "check:daily": "node scripts/check-daily-runway.ts",
    "check:seo": "node scripts/check-seo-output.ts",
    "check": "astro check && tsc --noEmit",
    "check:growth": "node scripts/check-growth.ts",
    "check:value": "node scripts/check-growth.ts && node scripts/check-content-value.ts && node scripts/check-inequality-example.ts && node scripts/check-teaching-cases.ts && node scripts/check-variant-packs.ts && node scripts/check-print-previews.ts",
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "npm run check:seo && npm run check:value",
    "preview": "astro preview",
    "gen:llms": "node scripts/gen-llms-full.ts",
    "gen:analysis-data": "node scripts/gen-analysis-data.ts",
    "gen:variant-packs": "node scripts/gen-variant-packs.ts && python3 scripts/gen-variant-pdfs.py",
    "gen:print-previews": "python3 scripts/gen-print-previews.py"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.6",
    "sharp": "^0.35.3",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "~5.9.3"
  }
}
