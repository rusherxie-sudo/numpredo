---
import Base from '../layouts/Base.astro';
import EditorialNote from './EditorialNote.astro';
import TeachingCase from './TeachingCase.astro';
import LogicModel from './LogicModel.astro';
import KillerSumDiagram from './KillerSumDiagram.astro';
import {LESSONS} from '../data/expansion/lessons.ts';
const {slug}=Astro.props;const lesson=LESSONS.find(l=>l.slug===slug)!;
const linkLabels:Record<string,string>={'/guide/techniques/pointing/':'ポインティングの図解','/guide/techniques/naked-triple/':'三国同盟の図解','/guide/techniques/hidden-pair/':'隠れたペアの図解','/guide/techniques/xy-wing/':'XY-Wingの図解','/guide/techniques/skyscraper/':'スカイスクレイパーの図解','/guide/techniques/naked-single/':'裸の単数の図解','/guide/techniques/hidden-single/':'隠れた単数の図解','/guide/techniques/naked-pair/':'二国同盟の図解','/guide/when-stuck/':'行き詰まったときの確認順','/tools/candidate-checker/':'候補数字を盤面から調べる','/print/candidate-notes/':'候補メモ用の印刷シート','/variants/killer/':'キラー数独を実際に解く','/tools/killer-combinations/':'ケージ合計の組み合わせを調べる','/print/killer/':'キラー数独の問題・解答PDF'};
const url=`https://numpredo.com${lesson.path}`;
const schema={'@context':'https://schema.org','@type':'LearningResource',name:lesson.title,description:lesson.description,url,inLanguage:'ja',learningResourceType:'解説と確認問題',isAccessibleForFree:true,author:{'@id':'https://numpredo.com/#operator'},publisher:{'@id':'https://numpredo.com/#organization'}};
---
<Base title={`${lesson.title} - numpredo`} description={lesson.description} canonical={url}>
 <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(schema)}/></Fragment>
 <nav class="crumb"><a href="/">ホーム</a> › <a href="/guide/">解き方</a> › {lesson.title.split('｜')[0]}</nav>
 <article>
 <h1>{lesson.title}</h1><p class="lead">{lesson.intro}</p>
 <EditorialNote verification={lesson.model ? '図は成立条件を学ぶための局所的な候補配置です。示した条件で消去が成立することと、条件を崩すと同じ消去ができない反例を検査しています。完成した一問の盤面とは区別しています。' : lesson.source ? '掲載例は題庫の実際の問題を解いた途中盤面です。唯一解と論理手順を検査し、その時点の候補から説明の根拠が成立することを照合しています。' : '合計45となる行・列・ブロックを基準に、本文と確認問題の計算、対象マスの範囲、重複の有無を確認しています。'} />
 <nav aria-label="このページの内容"><ul>{lesson.sections.map((s,i)=><li><a href={`#section-${i}`}>{s.heading}</a></li>)}<li><a href="#check">理解を確かめる3問</a></li></ul></nav>
 {lesson.model&&<><h2>候補の配置を確かめる</h2><LogicModel name={lesson.model}/></>}
 {slug==='killer-45-rule'&&<KillerSumDiagram />}
 {lesson.sections.map((s,i)=><section id={`section-${i}`}><h2>{s.heading}</h2>{s.body.map(p=><p>{p}</p>)}</section>)}
 {lesson.source&&<TeachingCase spec={{...lesson.source,heading:'実際の問題で確認する',question:'確定できる数字、または消せる候補を考え、根拠を説明してから答えを開いてください。'}}/>}
 <section id="check"><h2>理解を確かめる3問</h2><p>答えを開く前に、使った条件と消してよい範囲を自分の言葉で説明してみてください。</p>{(lesson.checks??[lesson.check]).map((check,i)=><div class="check-question"><h3>問{i+1}：{check.question}</h3><details><summary>問{i+1}の答えと根拠</summary><p><strong>{check.answer}</strong></p><p>{check.reason}</p></details></div>)}</section>
 {lesson.model&&<p class="note">ここでは局所的な成立条件を学びます。通常ゲームの自動ヒントが、このページのすべての手筋に対応しているわけではありません。</p>}
 <h2>関連する解説・練習</h2><ul>{lesson.related.map(path=><li><a href={path}>{LESSONS.find(l=>l.path===path)?.title.split('｜')[0]??linkLabels[path]??'関連する練習'}</a></li>)}</ul>
 <p><a href="/guide/">解き方一覧に戻る</a> ／ <a href="/practice/#one-move">9手筋の次の一手を練習する</a></p>
 </article>
</Base>
<style>
article{max-width:780px;margin:auto;}p{line-height:1.95;}section{margin:30px 0;}h1{line-height:1.45;}h2{margin-top:32px;} .check-question{margin:24px 0;} h3{font-size:18px;line-height:1.7;} section{scroll-margin-top:88px;}a{color:var(--accent);}li{line-height:1.8;margin:8px 0;}details{padding:16px;border:1px solid var(--line);border-radius:8px;background:var(--surface);}summary{cursor:pointer;font-weight:700;} .note{font-size:13px;color:var(--ink-3);}
</style>
