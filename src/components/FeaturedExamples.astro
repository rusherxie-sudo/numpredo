---
import { EXAMPLES } from '../data/expansion/examples.ts';
import { levelNames } from '../data/teaching-cases.ts';

interface Props { level?: string; }
const { level } = Astro.props;
const featured = level
  ? EXAMPLES.filter(example => example.spec.level === level)
  : EXAMPLES.filter(example => ['hidden-single-finish', 'naked-pair-breakthrough', 'x-wing-breakthrough'].includes(example.slug));
---

{featured.length > 0 && <section class="featured-examples" aria-label="実際の問題で学ぶ解き方">
  <h2>{level ? `${levelNames[featured[0].spec.level]}の一問を、解説を読みながら解く` : '実際の問題で学ぶ、数独の解き方'}</h2>
  <p>途中盤面の候補、次の一手の根拠、完成までの手順を掲載しています。まず自分で考え、説明と比べてみてください。</p>
  <div class="example-cards">
    {featured.map(example => <a href={example.path}>
      <span class="source">{levelNames[example.spec.level]} No.{example.spec.number}</span>
      <h3>{example.title}</h3>
      <p>{example.intro}</p>
      <span class="read">盤面と解説を読む →</span>
    </a>)}
  </div>
  <p class="more"><a href="/guide/solving-examples/">初級から超難問までの例題を比べる →</a> ／ <a href="/guide/">解き方・手筋の解説一覧</a></p>
</section>}

<style>
  .featured-examples { margin: 28px 0 36px; padding: 22px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  h2 { font-size: 23px; line-height: 1.5; margin: 0 0 10px; }
  p { line-height: 1.85; color: var(--ink-3); }
  .example-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: 14px; }
  .example-cards > a { display: block; padding: 18px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--ink); text-decoration: none; }
  .example-cards > a:hover { border-color: var(--accent); }
  h3 { margin: 8px 0; font-size: 18px; line-height: 1.6; }
  .source { font-size: 13px; color: var(--ink-3); }
  .read, .more a { color: var(--accent); }
  .read { font-weight: 600; }
  .more { margin-bottom: 0; }
</style>
