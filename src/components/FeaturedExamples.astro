---
import { EXAMPLES } from '../data/expansion/examples.ts';
import { levelNames, teachingCase } from '../data/teaching-cases.ts';

interface Props { level?: string; }
const { level } = Astro.props;
const selected = level
  ? EXAMPLES.filter(example => example.spec.level === level)
  : EXAMPLES.filter(example => ['hidden-single-finish', 'naked-pair-breakthrough', 'x-wing-breakthrough'].includes(example.slug));
const featured = selected.map(example => {
  const verified = teachingCase(example.spec);
  return { ...example, clues: verified.initial.filter(Boolean).length, totalSteps: verified.totalSteps, stepNumber: verified.stepNumber, techniqueName: verified.name };
});
---

{featured.length > 0 && <section class="featured-examples" aria-label="実際の問題で学ぶ解き方">
  <h2>{level ? `${levelNames[featured[0].spec.level]}の一問を、解説を読みながら解く` : '実際の問題で学ぶ、数独の解き方'}</h2>
  <p>途中盤面の候補、次の一手の根拠、完成までの手順を掲載しています。まず自分で考え、説明と比べてみてください。</p>
  <div class="example-cards">
    {featured.map(example => <article>
      <span class="source">{levelNames[example.spec.level]} No.{example.spec.number}</span>
      <h3><a href={example.path}>{example.title}</a></h3>
      <p>{example.intro}</p>
      <p class="proof">最初の数字{example.clues}個・解答手順{example.totalSteps}手。掲載する解き順では、{example.techniqueName}が{example.stepNumber}手目に登場します。</p>
      <nav class="example-actions" aria-label={`${levelNames[example.spec.level]}No.${example.spec.number}の取り組み方`}>
        <a class="read" href={example.path}>盤面と全手順の解説を読む →</a>
        <a href={`/play/${example.spec.level}/?n=${example.spec.number}#level-game`}>{levelNames[example.spec.level]} No.{example.spec.number}を無料で解く →</a>
      </nav>
    </article>)}
  </div>
  <p class="example-method">手数は掲載する解き順の一例で、所要時間ではありません。同じ問題を先に解き、行き詰まったところから解説と比べることもできます。</p>
  <p class="more"><a href="/guide/solving-examples/">初級から超難問までの例題を比べる →</a> ／ <a href="/guide/">解き方・手筋の解説一覧</a></p>
</section>}

<style>
  .featured-examples { margin: 28px 0 36px; padding: 22px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  h2 { font-size: 23px; line-height: 1.5; margin: 0 0 10px; }
  p { line-height: 1.85; color: var(--ink-3); }
  .example-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: 14px; }
  .example-cards > article { display: block; padding: 18px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--ink); min-width: 0; }
  .example-cards > article:focus-within { border-color: var(--accent); }
  h3 { margin: 8px 0; font-size: 18px; line-height: 1.6; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  .proof, .example-method { font-size: 13px; line-height: 1.8; }
  .example-actions { display: flex; flex-direction: column; gap: 6px; }
  .example-actions a { display: flex; align-items: center; min-height: 44px; color: var(--accent); text-underline-offset: 2px; }
  .source { font-size: 13px; color: var(--ink-3); }
  .read, .more a { color: var(--accent); }
  .read { font-weight: 600; }
  .more { margin-bottom: 0; }
</style>
