---
import {LESSONS} from '../data/expansion/lessons.ts';
import {EXAMPLES} from '../data/expansion/examples.ts';
import manifest from '../../public/downloads/collections/manifest.json';
interface Props {group:'lessons'|'examples'|'print';topic?:string;}
const {group,topic}=Astro.props;
let links=group==='lessons'?LESSONS.map(l=>({path:l.path,title:l.title,related:l.related})):group==='examples'?EXAMPLES.map(e=>({path:e.path,title:e.title,related:[`/guide/techniques/${e.techSlug}/`]})):manifest.packs.map(p=>({path:p.path,title:p.name,related:p.related}));
if(topic)links=links.filter(l=>l.related.includes(`/guide/techniques/${topic}/`));
const heading=group==='lessons'?'候補の読み方・手筋の違いを詳しく学ぶ':group==='examples'?'一問を最後まで解く・手筋別の実戦解説':'目的を決めて練習する・問題と解答のPDF';
---
{links.length>0&&<section class="expansion-links"><h2>{heading}</h2><ul>{links.map(l=><li><a href={l.path}>{l.title}</a></li>)}</ul></section>}
<style>.expansion-links{margin:30px 0;padding:18px;border:1px solid var(--line);border-radius:10px;background:var(--surface);}h2{font-size:21px;margin-top:0;}ul{padding-left:22px;}li{margin:10px 0;line-height:1.7;}a{color:var(--accent);}</style>
