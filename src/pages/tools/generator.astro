---
import Base from '../../layouts/Base.astro';
import PuzzleGenerator from '../../components/PuzzleGenerator.astro';
import beginner from '../../data/puzzles/beginner.json';
import intermediate from '../../data/puzzles/intermediate.json';
import advanced from '../../data/puzzles/advanced.json';
import hard from '../../data/puzzles/hard.json';
import extreme from '../../data/puzzles/extreme.json';
import { countSolutions, gridFromString, logicalSolve, renderBoardSvg, TECH_INFO } from '../../engine/index.ts';

const title = '数独作成ツール｜無料でナンプレ問題を自動生成・印刷 - numpredo';
const description = '無料の数独・ナンプレ作成ツール。初級〜超難問を選ぶだけで、唯一解・論理だけで解ける9×9問題と解答を自動生成。登録不要で印刷・PDF保存、問題URLの共有にも対応します。';
const url = 'https://numpredo.com/tools/generator/';
const pick = (source: typeof beginner) => source.puzzles.slice(0, 48).map(({ puzzle, solution, clues }) => ({ puzzle, solution, clues }));
const puzzles = {
  beginner: pick(beginner), intermediate: pick(intermediate), advanced: pick(advanced), hard: pick(hard), extreme: pick(extreme),
};
// 品質説明も一般論ではなく、実際の上級題をこの場で再検証した結果を表示する。
const validationPuzzle = advanced.puzzles[0];
const validationGrid = gridFromString(validationPuzzle.puzzle);
const validationSolution = gridFromString(validationPuzzle.solution);
const validationSolve = logicalSolve(validationGrid);
const validationSolutionCount = countSolutions(validationGrid, 2);
const validationGiven = validationGrid.map((value) => value !== 0);
const validationPuzzleSvg = renderBoardSvg(validationGrid, {
  given: validationGiven, cell: 28, title: '検証前の上級問題', desc: '独自エンジンで検証する実際の題面',
});
const validationSolutionSvg = renderBoardSvg(validationSolution, {
  given: validationGiven, cell: 28, title: '論理ソルバーの完成盤面', desc: '生成時の正解と81マスを照合',
});
const validationHardest = TECH_INFO[validationSolve.hardest ?? 'nakedSingle']?.ja ?? '裸の単数';
const faq = [
  { q: '作成した数独には必ず答えがありますか？', a: 'はい。すべての元問題は「解が一つだけ」であることを検証済みです。数字・行・列の配置を数独のルールを保つ方法で組み替えるため、作成後も唯一解が保たれます。' },
  { q: '難易度はどう決めていますか？', a: '空きマスの数だけではなく、論理的に解くときに必要な最も難しいテクニックと手順数で初級〜超難問の5段階に分類しています。' },
  { q: '作成した問題を印刷・PDF保存できますか？', a: 'はい。「印刷・PDF保存」を押し、ブラウザの印刷画面でプリンターまたは「PDFに保存」を選んでください。問題の次のページに解答も付きます。' },
  { q: '同じ問題を家族や生徒に共有できますか？', a: 'はい。「この問題のURLをコピー」で共有すると、同じ難易度・同じ盤面を相手のブラウザでも再現できます。登録は不要です。' },
  { q: '自分で数字を配置して数独を作れますか？', a: 'このツールは難易度を選んで完成した問題を自動作成する形式です。手元の盤面が解けるか、唯一解かを確認したい場合は<a href="/tools/solver/">数独自動解答ソルバー</a>へ入力してください。' },
];
const abs = (html: string) => html.replace(/href="\//g, 'href="https://numpredo.com/');
const webAppSchema = {
  '@context': 'https://schema.org', '@type': 'WebApplication', name: '数独・ナンプレ作成ツール', description, url,
  applicationCategory: 'UtilitiesApplication', operatingSystem: 'Web', inLanguage: 'ja',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' }, publisher: { '@id': 'https://numpredo.com/#organization' },
};
const howToSchema = {
  '@context': 'https://schema.org', '@type': 'HowTo', name: '無料で数独問題を作成して印刷する方法', description, inLanguage: 'ja', totalTime: 'PT1M',
  step: [
    { '@type': 'HowToStep', position: 1, name: '難易度を選ぶ', text: '初級・中級・上級・難問・超難問から作りたい難易度を選びます。', url: url + '#pg-tool-title' },
    { '@type': 'HowToStep', position: 2, name: '新しい問題を作成する', text: '「新しい問題を作成」を押すと、唯一解・論理解を検証済みの問題が表示されます。', url: url + '#pg-tool-title' },
    { '@type': 'HowToStep', position: 3, name: '印刷または共有する', text: '印刷・PDF保存、または問題を再現できるURLのコピーを選びます。', url: url + '#pg-tool-title' },
  ],
};
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: abs(f.a) } })) };
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://numpredo.com/' },
  { '@type': 'ListItem', position: 2, name: 'ツール', item: 'https://numpredo.com/tools/solver/' },
  { '@type': 'ListItem', position: 3, name: '数独作成ツール', item: url },
] };
---

<Base title={title} description={description} canonical={url} wide>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <header class="pg-page-head">
    <nav class="crumb"><a href="/">ホーム</a> › ツール › 数独作成</nav>
    <h1>数独作成ツール｜無料でナンプレ問題を自動生成・印刷</h1>
    <p class="lead">難易度を選ぶだけで、<strong>唯一解・当てずっぽうなし</strong>の9×9数独をすぐ作成。解答つきで印刷・PDF保存でき、同じ問題のURLも共有できます。</p>
  </header>

  <PuzzleGenerator puzzles={puzzles} />

  <div class="pg-content">
    <h2>「空きマスの数」だけで作らない数独ジェネレーター</h2>
    <p>数独の難しさは、数字が少ないほど高いとは限りません。この作成ツールは、各問題を人間向けの解法で最後まで解き、必要になる最も難しいテクニックと手順数から難易度を分類しています。初級は基本の単数、中級以上は候補の絞り込み、難問では高度な手筋が必要になるように分かれています。</p>
    <p>元になる問題はすべて、①解が一つだけ、②推測なしで論理的に解ける、③論理解と生成時の解答が一致する、という3条件を検証済みです。作成ボタンを押すと、その品質を保つ数字・行・列の組み替えを行い、新しい盤面として表示します。</p>

    <h2 id="quality-verification">実際の一問で見る生成・検証の4工程</h2>
    <p>下は説明用に作った架空の数値ではなく、現在の上級題庫から一問を読み込み、このページの構築時にもう一度検査した結果です。題庫やエンジンに不整合があれば、公開前の構築チェックで検出されます。</p>
    <div class="validation-result" aria-label="問題の検証結果">
      <div><span>唯一解検査</span><strong>{validationSolutionCount === 1 ? '合格（1解）' : `不合格（${validationSolutionCount}解）`}</strong></div>
      <div><span>論理だけで完答</span><strong>{validationSolve.solved ? '合格' : '不合格'}</strong></div>
      <div><span>最難テクニック</span><strong>{validationHardest}</strong></div>
      <div><span>論理ステップ</span><strong>{validationSolve.steps.length}手</strong></div>
    </div>
    <div class="validation-boards">
      <figure><Fragment set:html={validationPuzzleSvg} /><figcaption>工程1〜2：完成盤から数字を外し、別解がないか検査</figcaption></figure>
      <figure><Fragment set:html={validationSolutionSvg} /><figcaption>工程3〜4：論理だけで完答し、生成時の正解と照合</figcaption></figure>
    </div>
    <ol class="validation-steps">
      <li><strong>完成盤を作る：</strong>行・列・3×3ブロックで1〜9が重複しない81マスを作成します。</li>
      <li><strong>数字を外して唯一解を守る：</strong>数字を外すたびに解の個数を調べ、別解が生まれる変更は採用しません。</li>
      <li><strong>人間向けの手筋で解く：</strong>単数、区画の絞り込み、ペアなどを易しい順に適用し、推測せず完成できることを確認します。</li>
      <li><strong>正解照合と難易度判定：</strong>論理解が生成時の正解と一致するか確認し、最も難しい手筋と手数から5段階へ分類します。</li>
    </ol>
    <p>全題庫のヒント数・手数・手筋を横断して確認した結果は、<a href="/research/puzzle-analysis/">全4,395問の数独分析</a>で集計方法とともに公開しています。</p>

    <h2>家庭・教室・施設で1問だけ作りたいときに</h2>
    <p>「今日は中級を一題」「生徒全員に同じ問題を配る」といった用途なら、このページで一問を作り、そのまま印刷するのが最短です。URLをコピーすれば、離れた相手にも同じ盤面を渡せます。複数問を一枚にまとめたい場合は、問題数や見出しを選べる<a href="/print/">無料の数独問題集・PDF印刷</a>をご利用ください。</p>
    <ol>
      <li>初級〜超難問から難易度を選ぶ。</li>
      <li>「新しい問題を作成」で盤面を決める。</li>
      <li>解答を確認するか、印刷・PDF保存・URL共有を選ぶ。</li>
    </ol>

    <h2>数独作成ツールについてよくある質問</h2>
    <dl class="faq">{faq.map((f) => (<><dt>{f.q}</dt><dd set:html={f.a} /></>))}</dl>

    <h2>関連ツール</h2>
    <ul>
      <li><a href="/print/">複数問の数独問題集を作成・印刷</a></li>
      <li><a href="/tools/solver/">自作・手持ち問題の答えと唯一解を確認</a></li>
      <li><a href="/guide/how-to-solve/">数独の解き方とテクニック</a></li>
    </ul>
  </div>

  <style is:global>
    .fsh { display: none; }
    .crumb { font-size: 12px; color: var(--ink-3); margin-bottom: 10px; } .crumb a { color: var(--ink-3); text-decoration: none; }
    .lead { max-width: 760px; color: var(--ink-3); font-size: 14px; line-height: 1.85; }
    .pg-content { max-width: 820px; margin-inline: auto; }
    .pg-content p, .pg-content li { line-height: 1.9; }
    .pg-content a, .faq a { color: var(--accent); }
    .validation-result { display: grid; grid-template-columns: repeat(4, 1fr); gap: 9px; margin: 18px 0; }
    .validation-result div { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface-2); padding: 12px; text-align: center; }
    .validation-result span, .validation-result strong { display: block; }
    .validation-result span { color: var(--ink-3); font-size: 11px; }
    .validation-result strong { color: var(--accent); font-size: 14px; margin-top: 4px; }
    .validation-boards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .validation-boards figure { margin: 0; }
    .validation-boards svg { display: block; width: 100%; height: auto; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
    .validation-boards figcaption { color: var(--ink-3); font-size: 11px; text-align: center; margin-top: 5px; }
    .validation-steps { padding-left: 1.4em; }
    .validation-steps li { margin-bottom: 8px; }
    .faq dt { margin-top: 16px; font-family: var(--font-mincho); font-weight: 700; }
    .faq dd { margin: 5px 0 0; color: var(--ink-3); line-height: 1.8; }
    @media (max-width: 680px) { .validation-result { grid-template-columns: repeat(2, 1fr); } .validation-boards { grid-template-columns: 1fr; } }
  </style>
</Base>
