---
import Base from '../../layouts/Base.astro';
import lastmodJson from '../../data/sitemap-lastmod.json';
import publishedJson from '../../data/published.json';
import { SOLVER_SAMPLE } from '../../data/solver-sample.ts';
import {
  countSolutions,
  gridFromString,
  levelOf,
  LEVEL_META,
  logicalSolve,
  renderBoardSvg,
  renderStepFigures,
  solveOne,
  TECH_INFO,
  TOKEN_THEME,
  traceKeySteps,
} from '../../engine/index.ts';
const lastmod: Record<string, string> = lastmodJson;
const published: Record<string, string> = publishedJson;

const title = 'ナンプレ自動解答（無料）｜写真・カメラで数独の答え合わせ - numpredo';
const description = 'ナンプレ・数独の答えを無料で自動表示。新聞や雑誌の問題を写真・カメラ・画像から読み取り、手入力にも対応します。唯一解の判定と解き方の手順も見られる9×9ソルバーです。';
const url = 'https://numpredo.com/tools/solver/';
const datePublished = published['/tools/solver/'];
const dateModified = lastmod['/tools/solver/'];
const dateModifiedLabel = dateModified?.slice(0, 10).replace(/-/g, '/');

// 静态图解与浏览器样例共用输入，校验不通过时不得输出教学内容。
const exampleGrid = gridFromString(SOLVER_SAMPLE);
const exampleGiven = exampleGrid.map((v) => v !== 0);
const exampleSol = solveOne(exampleGrid.slice());
const exampleCount = countSolutions(exampleGrid.slice(), 2);
const exampleRes = logicalSolve(exampleGrid.slice());
if (exampleCount !== 1) throw new Error('SOLVER_SAMPLE 必须具有唯一解');
if (!exampleSol) throw new Error('SOLVER_SAMPLE 无解');
if (!exampleRes.solved) throw new Error('SOLVER_SAMPLE 无法纯逻辑求解');
if (exampleRes.grid.join('') !== exampleSol.join('')) throw new Error('SOLVER_SAMPLE 的逻辑解与回溯解不一致');
const exampleClues = exampleGrid.filter((v) => v !== 0).length;
const exampleSteps = exampleRes.steps.length;
const exampleHardest = exampleRes.hardest ?? 'nakedSingle';
const exampleHardestJa = TECH_INFO[exampleHardest]?.ja ?? exampleHardest;
const exampleLevelJa = LEVEL_META[levelOf(exampleRes)].ja;
const examplePuzzleSvg = renderBoardSvg(exampleGrid, {
  given: exampleGiven, theme: TOKEN_THEME, cell: 30,
  title: '数独ソルバーの例題（サンプルと同じ問題）', desc: 'ヒントの数字を太字で表示した9×9の問題盤面。',
});
const exampleSolSvg = renderBoardSvg(exampleSol, {
  given: exampleGiven, theme: TOKEN_THEME, cell: 30,
  title: '数独ソルバーの例題の解答', desc: '唯一解の完成盤面。最初からある数字以外が解答で埋めた数字。',
});
const exampleKeyFigs = renderStepFigures(traceKeySteps(exampleGrid.slice(), { maxSteps: 2 }), exampleGiven, 26);

const faq = [
  { q: '写真や画像から問題を読み取れますか？', a: 'はい。新聞・雑誌の数独・ナンプレを撮影するか、スクリーンショットなどの画像を選ぶと、盤面のマス目を自動で読み取り、上の盤面に反映します。明るく、なるべく正面から撮ると読み取りやすくなります。読み取った画像は端末内だけで処理され、サーバーには送信されません。' },
  { q: '読み取りが間違っていたら？', a: '読み取りは完璧ではありません。反映された盤面を見て、<strong>黄色のマス（確信度が低い箇所）</strong>や誤読したマスをタップし、数字キーで直してから「解く」を押してください。最初から手入力で使うこともできます。' },
  { q: 'ナンプレ・数独を自動で解いて、答え合わせに使えますか？', a: 'はい。盤面を入力（または写真から読み取り）して「解く」を押すと、自動で計算して答えの盤面を表示します。無料・登録不要なので、新聞・雑誌の答え合わせや、自分で解いた答えの確認にもお使いいただけます。' },
  { q: '解き方の手順（途中式）も見られますか？', a: '対応している手筋で論理的に解ける範囲は見られます。「解く」を押すと、答えの盤面の下に、各ステップで使った手筋の名前と、消える候補・確定するマスが盤面図つきで並びます。難易度の目安（初級〜超難問）も自動で判定します。' },
  { q: 'このソルバーで数独の解き方も学べますか？', a: '手順の図解で「どの手筋を、どのマスに使うか」を確認できるので、答え合わせをしながら解き方の練習に使えます。手筋ごとのくわしい解説は<a href="/guide/how-to-solve/">解き方ガイド</a>と各テクニックの解説ページで読めます。' },
  { q: '解が複数ある問題でも使えますか？', a: '入力した問題が「唯一解かどうか」を自動で判定します。解が複数ある場合はその旨を表示し、一例を解答します。数独は解が一つに決まるのがルールなので、手入力の数字が間違っていないかも確認してみてください。' },
  { q: '16×16・6×6や変則ルールにも対応していますか？', a: 'このソルバーは9×9の標準数独専用です。16×16（1〜9・A〜G）は<a href="/variants/16x16/">16×16ナンプレ自動解答</a>で手入力・一括入力できます。キラー数独・対角線数独は、それぞれの無料プレイページをご利用ください。' },
];
const webAppSchema = {
  '@context': 'https://schema.org', '@type': 'WebApplication',
  name: 'ナンプレ自動解答プログラム（写真・カメラ対応）',
  alternateName: ['数独解答プログラム', 'ナンプレ解答ツール', '写真ソルバー'],
  description, url,
  applicationCategory: 'UtilitiesApplication', operatingSystem: 'Web', inLanguage: 'ja',
  featureList: ['写真・画像から9×9盤面を読み取り', '盤面への手入力', '唯一解・複数解の判定', '論理解法を一手ずつ図解'],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
  publisher: { '@id': 'https://numpredo.com/#organization' },
  ...(datePublished ? { datePublished } : {}),
  ...(dateModified ? { dateModified } : {}),
};
// JSON-LD 内链接统一转成绝对 URL（被脱离页面上下文消费时也能解析）
const abs = (h: string): string => h.replace(/href="\//g, 'href="https://numpredo.com/');
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: abs(f.a) } })) };
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://numpredo.com/' }, { '@type': 'ListItem', position: 2, name: 'プレイ', item: 'https://numpredo.com/play/' }, { '@type': 'ListItem', position: 3, name: 'ソルバー', item: url }] };
---

<Base title={title} description={description} wide>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <nav class="crumb"><a href="/">ホーム</a> › <a href="/play/">プレイ</a> › ソルバー</nav>
  <h1>ナンプレ自動解答｜写真・カメラで答え合わせできる無料数独ソルバー</h1>
  <p class="lead">新聞・雑誌の数独（ナンプレ）を、<strong>カメラで撮る／画像を選ぶだけ</strong>で自動読み取りして答えを計算します。手入力でもOK、無料・登録不要（<strong>9×9 の標準ルール専用</strong>）。今日の練習問題は<a href="/daily/">日替わりナンプレ</a>、自力で解く手順は<a href="/guide/how-to-solve/">解き方ガイド</a>へどうぞ。</p>
  {dateModifiedLabel && <p class="sv-updated"><time datetime={dateModified}>最終更新日：{dateModifiedLabel}</time></p>}

  <div class="sv-photo">
    <label class="sv-photo-btn sv-photo-cam"><input type="file" accept="image/*" capture="environment" data-photo hidden />カメラで撮影</label>
    <label class="sv-photo-btn"><input type="file" accept="image/*" data-photo hidden />画像・スクショを選ぶ</label>
    <span class="sv-photo-or">または下の盤面に直接入力</span>
  </div>

  <p id="sv-msg" class="sv-msg"></p>
  <div id="sv-app">
    {/* 静态骨架盘面：JS 加载前防白屏；ocr-solve.ts 会用 innerHTML='' 替换，勿改结构 */}
    <div class="sv-layout" aria-hidden="true">
      <div class="sv-left">
        <div class="sv-board">
          {Array.from({ length: 81 }, (_, i) => {
            const r = (i / 9) | 0;
            const c = i % 9;
            return <div class={`sv-cell${c === 2 || c === 5 ? ' sv-br' : ''}${r === 2 || r === 5 ? ' sv-bb' : ''}`} />;
          })}
        </div>
      </div>
      <div class="sv-skeleton-side">
        <div class="sv-skeleton-pad">{Array.from({ length: 10 }, () => <span />)}</div>
        <span class="sv-skeleton-go"></span>
        <div class="sv-skeleton-subs"><span></span><span></span></div>
      </div>
    </div>
  </div>

  <div id="sv-steps" class="sv-steps" hidden></div>

  {/* 静态示例：JS 不执行也能读到；与“サンプル”按钮同一盘面；用 <details> 收折放于 app 下方 */}
  <section class="sv-example" data-solver-example data-puzzle={SOLVER_SAMPLE} data-clues={exampleClues} data-steps={exampleSteps} data-level={exampleLevelJa} data-hardest={exampleHardestJa}>
    <h2>実際の問題で「解く」までの流れを確認する</h2>
    <p>画面上部の「<strong>サンプル</strong>」ボタンで読み込める問題と<strong>同じ盤面</strong>を、ソルバーが実際に解いた結果です。この例題はヒント<strong>{exampleClues}個</strong>・論理手数<strong>{exampleSteps}手</strong>で、最難テクニックは<strong>{exampleHardestJa}</strong>（難易度の目安：{exampleLevelJa}）。上部の「サンプル」→「解く」でも、この問題の答えと解法手順をブラウザ上で確認できます。</p>
    <details class="sv-example-box">
      <summary>例題の盤面・解答・手順を開く</summary>
      <div class="sv-example-grid">
        <figure><Fragment set:html={examplePuzzleSvg} /><figcaption>問題（黒い太字＝最初からあるヒント）</figcaption></figure>
        <figure><Fragment set:html={exampleSolSvg} /><figcaption>解答（緑＝ソルバーが埋めた数字）</figcaption></figure>
      </div>
      <p class="sv-example-stat">検証結果：ヒント{exampleClues}個／論理手数{exampleSteps}手／最難テクニック：{exampleHardestJa}／難易度の目安：{exampleLevelJa}。この問題は解が一つだけ（唯一解）で、当てずっぽうなしの論理だけで最後まで埋まります。</p>
      <h3>この盤面を論理的に解く途中で、候補を絞り込む手筋の例</h3>
      <p class="sv-example-note">下の2枚は、ソルバーがこの問題を解いた論理手順（全{exampleSteps}手）のうち、候補を絞り込む代表的な手を抜粋したものです。「抜粋1・2」はこの見本内での通し番号で、解法全体の手番ではありません。</p>
      <div class="sv-example-steps">
        {exampleKeyFigs.map((f, i) => (
          <figure class="sv-example-step"><Fragment set:html={f.svg} /><figcaption><strong>抜粋 {i + 1}（{f.label.replace(/^手順 \d+：/, '')}）</strong>{f.slug ? <> — <a href={`/guide/techniques/${f.slug}/`}>手筋の解説</a></> : ''}</figcaption><p>{f.text}</p></figure>
        ))}
      </div>
    </details>
  </section>

  <h2>解答と、その盤面に合った「解き方の手順」を表示します</h2>
  <p>盤面を入力して「解く」を押すと、<strong>答えの盤面</strong>を表示します（入力したマスは黒、解いて埋まったマスは緑）。9×9の標準ルールでは、入力した問題が「解が一つだけか（唯一解か）」も自動で判定します。</p>
  <p>答えを出すだけでなく、<strong>対応している手筋で論理的に解ける範囲</strong>は「解き方の手順」として盤面図つきで並びます。各ステップで使った手筋の名前と、消える候補・確定するマスが図示されるので、答え合わせをしながら「なぜそこに数字が入るのか」を確認できます。難易度の目安（初級〜超難問）も自動で判定します。</p>
  <p>判定できる手筋は<a href="/guide/techniques/naked-pair/">ペア（二国同盟）</a>・<a href="/guide/techniques/x-wing/">X-Wing</a>・<a href="/guide/techniques/swordfish/">スワードフィッシュ</a>・<a href="/guide/techniques/skyscraper/">スカイスクレイパー</a>まで。難問・超難問でも、対応する手筋で解ける範囲の根拠を図解します。それぞれの手筋の詳しい解説と練習方法は<a href="/guide/how-to-solve/">数独・ナンプレの解き方ガイド</a>へどうぞ。</p>

  <h2>写真・カメラでの読み取り方と注意点</h2>
  <p>スマホのカメラで撮影するか、保存済みの画像・スクリーンショットを選ぶと、盤面のマス目を自動で読み取って上の盤面に反映します。読み取った結果を確認・修正して「解く」を押すだけで、写真の数独を解答できます。手順は次の3つです。</p>
  <ol>
    <li><strong>盤面全体を正面から撮る。</strong>明るい場所で、影や反射が入らないようにします。</li>
    <li><strong>読み取り結果を確認する。</strong>読み取りは完璧ではありません。<strong>黄色のマスは確信度が低い箇所</strong>です。間違っているマスをタップし、数字キーで直してください。</li>
    <li><strong>「解く」を押す。</strong>修正が終わったら解答を表示します。最初から手入力で使うこともできます。</li>
  </ol>
  <p><strong>画像はお使いの端末内だけで処理され、サーバーには送信されません。</strong>対象は9×9の標準ルールのみです。うまく読み取れないときは、盤面が画面いっぱいになるよう撮り直すか、手入力してください。</p>

  <h2>新聞・雑誌の数独・ナンプレの答え合わせに使う</h2>
  <p>新聞（読売・毎日・朝日など）や雑誌のナンプレ・数独が解けないとき、紙面の答え発表を待たずに答え合わせができます。撮影した問題、または手入力した問題に「解く」を押すだけで、正しい解答を表示します。答え合わせの手順は次の3ステップです。</p>
  <ol>
    <li>紙面の<strong>問題</strong>（自分の答えではなく、最初から印刷されている数字）を撮影するか、上の盤面に入力します。</li>
    <li>読み取り結果を確認し、間違っているマスをタップして修正します。</li>
    <li>「解く」を押して正しい解答を表示し、自分の答えと見比べます。違うマスがあれば、そこが間違いです。</li>
  </ol>
  <p>解が複数ある問題では、その旨を表示したうえで一例を解答します。くわしくは<a href="/guide/newspaper/">新聞の数独・ナンプレが解けないときの答え合わせ方法</a>をどうぞ。</p>

  <h2>対応している範囲と限界</h2>
  <ul>
    <li>対象は<strong>9×9の標準数独</strong>です。16×16（1〜9・A〜G）は<a href="/variants/16x16/">16×16ナンプレ自動解答</a>、キラー数独・対角線数独はそれぞれのプレイページをご利用ください。</li>
    <li>写真の読み取りは自動ですが、誤読があり得ます。黄色のマスを確認・修正してから「解く」を押してください。</li>
    <li>論理解説は当サイトのソルバーが対応している手筋の範囲です。対応する手筋だけでは最後まで解けない問題でも、<strong>答えそのものは上の盤面に表示</strong>されます。</li>
    <li>読み取った画像は端末内だけで処理され、外部へ送信されません。</li>
  </ul>

  <h2>よくある質問</h2>
  <dl class="faq">{faq.map((f) => (<><dt>{f.q}</dt><dd set:html={f.a}></dd></>))}</dl>

  <h2>関連</h2>
  <ul>
    <li><a href="/variants/16x16/">16×16ナンプレを自動解答する</a></li>
    <li><a href="/tools/candidate-checker/">答えを見ずに候補数字と次の一手だけ確認する</a></li>
    <li><a href="/guide/sudoku-algorithm/">数独ソルバーのアルゴリズムと唯一解判定を学ぶ</a></li>
    <li><a href="/guide/newspaper/">新聞の数独・ナンプレが解けないとき</a></li>
    <li><a href="/guide/how-to-solve/">自力で解くための解き方ガイド</a></li>
    <li><a href="/play/advanced/">上級をプレイ</a></li>
  </ul>

  <script>
    import '../../client/ocr-solve.ts';
  </script>

  <style is:global>
    .crumb { font-size: 12px; color: var(--ink-3); margin-bottom: 10px; } .crumb a { color: var(--ink-3); text-decoration: none; }
    .lead { color: var(--ink-3); font-size: 14px; margin: 0 0 16px; }
    .sv-updated { color: var(--ink-4); font-size: 12px; margin: -10px 0 16px; }
    main ul { line-height: 2; } main ul a { color: var(--accent); }
    main ol { line-height: 2; padding-left: 1.4em; }
    .faq dt { font-weight: 700; margin-top: 14px; } .faq dd { margin: 4px 0 0; color: var(--ink-3); font-size: 14px; } .faq a { color: var(--accent); }

    .sv-photo { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin: 0 0 14px; }
    .sv-photo-btn { display: inline-flex; align-items: center; gap: 8px; background: var(--accent); color: var(--accent-on); font-size: var(--text-base); font-weight: 700; padding: 12px 20px; border-radius: var(--radius); cursor: pointer; }
    .sv-photo-btn:hover { background: var(--accent-ink); }
    .sv-photo-or { font-size: var(--text-sm); color: var(--ink-4); }

    .sv-layout { display: grid; grid-template-columns: 1fr 280px; gap: 24px; align-items: start; max-width: 760px; }
    .sv-board { display: grid; grid-template-columns: repeat(9, 1fr); aspect-ratio: 1; max-width: 460px; margin: 0 auto; border: 2px solid var(--board-edge); background: var(--board-bg); border-radius: 4px; overflow: hidden; }
    /* aria 行容器（role=row）不参与布局；盘面/键盘禁文字选中（触控连点不弹选字） */
    .sv-rowg { display: contents; }
    .sv-board, .sv-pad, .sv-ctrl { -webkit-user-select: none; user-select: none; }
    .sv-cell { border: 0.5px solid var(--cell-line); background: transparent; display: flex; align-items: center; justify-content: center; font-size: clamp(18px, 4.2vw, 26px); cursor: pointer; padding: 0; color: var(--ink-4); font-family: var(--font-sans); }
    .sv-cell.sv-br { border-right: 2px solid var(--box-line); }
    .sv-cell.sv-bb { border-bottom: 2px solid var(--box-line); }
    .sv-cell.sv-given { color: var(--num-given); font-family: var(--font-mincho); font-weight: 700; }
    .sv-cell.sv-sel { background: var(--cell-sel-bg); box-shadow: inset 0 0 0 2px var(--accent); }
    .sv-cell.sv-err { color: var(--num-error) !important; background: var(--cell-error-bg); text-decoration: underline wavy; text-underline-offset: 2px; }
    .sv-cell.sv-ocr-uncertain { background: color-mix(in srgb, var(--accent) 14%, var(--surface)); box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--accent) 55%, transparent); }
    .sv-cell.sv-solved { color: var(--num-user); font-weight: 700; }

    .sv-pad { display: grid; grid-template-columns: repeat(5, 1fr); gap: 7px; }
    .sv-key { padding: 14px 0; font-size: 20px; border: 1px solid var(--key-line); border-radius: 6px; background: var(--key-bg); color: var(--key-ink); cursor: pointer; font-family: var(--font-mincho); }
    .sv-key:hover { background: var(--key-hover); }
    .sv-del { font-size: 13px; font-family: var(--font-sans); color: var(--ink-3); }
    .sv-ctrl { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; }
    .sv-go { flex: 1 1 100%; padding: 13px 0; border: 0; border-radius: var(--radius); background: var(--accent); color: var(--accent-on); font-size: var(--text-md); font-weight: 700; cursor: pointer; }
    .sv-go:hover { background: var(--accent-ink); }
    .sv-sub { flex: 1 1 40%; padding: 10px 0; border: 1px solid var(--line-2); border-radius: var(--radius); background: var(--surface); color: var(--ink); font-size: var(--text-sm); cursor: pointer; }
    .sv-sub:hover { border-color: var(--accent); color: var(--accent); }

    /* 静态骨架(aria-hidden)不可交互:不给手型指针,避免 JS 未加载时的可点击假象 */
    #sv-app [aria-hidden='true'] .sv-cell { cursor: default; }
    .sv-skeleton-side { min-height: 250px; }
    .sv-skeleton-pad { display: grid; grid-template-columns: repeat(5, 1fr); gap: 7px; }
