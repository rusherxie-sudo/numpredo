---
import VariantPlayPage from '../../components/VariantPlayPage.astro';
import VariantGame from '../../components/VariantGame.astro';
import { MINI6_PUZZLES } from '../../data/mini6.ts';
const puzzles=MINI6_PUZZLES.map((p,i)=>({...p,id:`mini6-${i+1}`}));
---
