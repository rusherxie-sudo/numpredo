---
import Base from '../../layouts/Base.astro';
import SudokuGame from '../../components/SudokuGame.astro';
import { LEVELS } from '../../data/levels.ts';

const pcLevel = LEVELS.find((level) => level.slug === 'intermediate');
if (!pcLevel) throw new Error('中級問題が見つかりません');

const title = 'パソコンで無料ナンプレ｜インストール不要の数独ゲーム - numpredo';
const description = 'パソコンで無料ナンプレを今すぐプレイ。インストール・登録不要のブラウザ版数独です。矢印キー、数字キー、Delete、Ctrl+Zに対応し、中級問題を大きな盤面で遊べます。';
const url = 'https://numpredo.com/play/pc/';
const faq = [
  {
    q: 'パソコンにアプリをインストールする必要はありますか？',
    a: 'いいえ。ブラウザだけで遊べるため、ダウンロードも会員登録も不要です。このページを開けばすぐに無料で始められます。',
  },
  {
    q: 'WindowsとMacの両方で遊べますか？',
    a: 'はい。Windows、Mac、Chromebookなど、一般的なブラウザが動くパソコンで遊べます。特別なソフトは必要ありません。',
  },
  {
    q: 'キーボードだけでナンプレを操作できますか？',
    a: 'はい。矢印キーでマスを移動し、1〜9で入力、Delete・Backspace・0で消去できます。Ctrl+Z（Macは⌘Z）で一手戻せます。',
  },
  {
    q: '途中まで解いた問題は保存されますか？',
    a: '同じブラウザでは進行状況が端末内に自動保存されます。履歴やサイトデータを消した場合、別のパソコンや別のブラウザには引き継がれません。',
  },
  {
    q: 'パソコンから数独を印刷できますか？',
    a: '<a href="/print/">無料の数独PDF・印刷ページ</a>で、難易度・問題数・答えの有無を選んで印刷できます。',
  },
];
const abs = (html: string): string => html.replace(/href="\//g, 'href="https://numpredo.com/');
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'パソコン版 無料ナンプレ・数独ゲーム',
  description,
  url,
  applicationCategory: 'GameApplication',
  operatingSystem: 'Windows, macOS, ChromeOS, Linux',
  browserRequirements: 'JavaScript対応のウェブブラウザ',
  inLanguage: 'ja',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
  publisher: { '@id': 'https://numpredo.com/#organization' },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: abs(item.a) },
  })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://numpredo.com/' },
    { '@type': 'ListItem', position: 2, name: 'プレイ', item: 'https://numpredo.com/play/' },
    { '@type': 'ListItem', position: 3, name: 'パソコン版', item: url },
  ],
};
---

<Base title={title} description={description} canonical={url} wide>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <div class="pc-copy">
    <nav class="crumb"><a href="/">ホーム</a> › <a href="/play/">無料ゲーム</a> › パソコン版</nav>
    <h1>パソコンで無料ナンプレ｜インストール不要の数独ゲーム</h1>
    <p class="lead">ダウンロードも登録も不要。大きな盤面とキーボード操作で、中級ナンプレをすぐに遊べます。問題はすべて唯一解で、当てずっぽうなしに論理だけで解けることを確認済みです。</p>
    <div class="pc-points" aria-label="パソコン版の特徴">
      <span>無料・登録不要</span><span>ブラウザですぐ遊べる</span><span>キーボード対応</span><span>途中保存</span>
    </div>
    <p class="jump"><a href="#pc-game">今すぐパソコンでナンプレを遊ぶ</a></p>
  </div>

  <div id="pc-game">
    <SudokuGame
      level="pc-intermediate"
      levelJa="パソコン版・中級"
      url={url}
      set={pcLevel.puzzles.slice(0, 30).map((p) => ({ puzzle: p.puzzle }))}
    />
  </div>

  <div class="pc-copy">
    <section aria-labelledby="keyboard-title">
      <h2 id="keyboard-title">パソコンのキーボード操作</h2>
      <p>マウスで数字を選ぶこともできますが、盤面から手を離さずにキーボードだけで進めると入力が速くなります。</p>
      <div class="key-table-wrap">
        <table class="key-table">
          <thead><tr><th>キー</th><th>操作</th><th>使いどころ</th></tr></thead>
          <tbody>
            <tr><td><kbd>↑</kbd><kbd>↓</kbd><kbd>←</kbd><kbd>→</kbd></td><td>マスを移動</td><td>盤面を見ながら片手で選択</td></tr>
            <tr><td><kbd>1</kbd>〜<kbd>9</kbd></td><td>数字を入力</td><td>選択中のマスへ確定数字・メモを入力</td></tr>
            <tr><td><kbd>Delete</kbd> / <kbd>Backspace</kbd> / <kbd>0</kbd></td><td>数字を消す</td><td>入力を訂正</td></tr>
            <tr><td><kbd>Ctrl</kbd>+<kbd>Z</kbd>（Macは <kbd>⌘</kbd>+<kbd>Z</kbd>）</td><td>一手戻す</td><td>直前の入力を取り消す</td></tr>
            <tr><td><kbd>Ctrl</kbd>+<kbd>Y</kbd>（Macは <kbd>⌘</kbd>+<kbd>Y</kbd>）</td><td>やり直す</td><td>取り消した操作を戻す</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2>パソコンで遊ぶときのおすすめ設定</h2>
      <ol>
        <li><strong>盤面を大きく表示する：</strong>ブラウザの拡大率は100〜125％を目安にし、盤面と数字パッドが同時に見える大きさにします。</li>
        <li><strong>最初は「間違いを赤く表示」をオン：</strong>正解と異なる数字を入力した時点で確認できるため、入力ミスを早めに直せます。</li>
        <li><strong>候補は「メモ」で入力：</strong>中級で止まったら、入り得る数字を候補として書き、確定した数字から消していきます。</li>
        <li><strong>途中で離れるときは一時停止：</strong>同じブラウザなら進行状況も端末内へ保存され、あとで続きを解けます。</li>
      </ol>
    </section>

    <section>
      <h2>難易度を選んで無料で遊ぶ</h2>
      <p>このページは中級から始まります。初めてなら初級、手応えを求めるなら上級以上を選んでください。どの難易度もパソコンのキーボードで操作できます。</p>
      <div class="level-grid">
        {LEVELS.map((level) => (
          <a href={`/play/${level.slug}/`}><strong>{level.ja}</strong><span>{level.en}</span></a>
        ))}
      </div>
    </section>

    <section>
      <h2>ダウンロード版ではなくブラウザ版を使う利点</h2>
      <p>ソフトのインストールや更新作業がなく、共有パソコンでもページを開くだけで始められます。会員登録やメールアドレスも不要です。進行状況は外部アカウントへ送らず、利用中のブラウザ内に保存します。</p>
      <p>紙と鉛筆で解きたい場合は、<a href="/print/">無料の数独問題集・PDF印刷</a>へ。問題の答え合わせや自分で入力した盤面を解く場合は、<a href="/tools/solver/">数独自動解答ソルバー</a>を利用できます。</p>
    </section>

    <section>
      <h2>よくある質問</h2>
      <dl class="faq">
        {faq.map((item) => <><dt>{item.q}</dt><dd set:html={item.a} /></>)}
      </dl>
    </section>
  </div>

  <style>
    .pc-copy { max-width: 1060px; margin: 0 auto; }
    .crumb { margin-bottom: 10px; color: var(--ink-3); font-size: var(--text-xs); }
    .crumb a { color: var(--ink-3); text-decoration: none; }
    .lead { max-width: 820px; color: var(--ink-2); line-height: 1.85; }
    .pc-points { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0; }
    .pc-points span { padding: 5px 11px; border: 1px solid var(--line-2); border-radius: var(--radius-pill); background: var(--surface-2); color: var(--ink-2); font-size: var(--text-sm); }
    .jump { margin: 14px 0 20px; }
    .jump a { display: inline-block; padding: 10px 18px; border-radius: var(--radius-sm); background: var(--accent); color: var(--accent-on); font-weight: 700; text-decoration: none; }
    .key-table-wrap { overflow-x: auto; }
    .key-table { width: 100%; border-collapse: collapse; background: var(--surface); }
    .key-table th, .key-table td { padding: 11px 12px; border: 1px solid var(--line); text-align: left; }
    .key-table th { background: var(--surface-2); font-family: var(--font-mincho); }
    kbd { display: inline-block; min-width: 25px; margin: 1px 2px; padding: 2px 6px; border: 1px solid var(--line-2); border-bottom-width: 2px; border-radius: 4px; background: var(--bg); text-align: center; font-family: var(--font-sans); font-size: .9em; }
    .level-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }
    .level-grid a { display: flex; flex-direction: column; gap: 3px; padding: 12px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); color: var(--ink); text-align: center; text-decoration: none; }
    .level-grid a:hover { border-color: var(--accent); }
    .level-grid span { color: var(--ink-3); font-size: var(--text-xs); }
    .faq dt { margin-top: 16px; font-family: var(--font-mincho); font-weight: 700; }
    .faq dd { margin: 5px 0 0; color: var(--ink-3); line-height: 1.8; }
    .faq a, section a { color: var(--accent); }
    section { margin-top: 30px; }
    section li { margin-bottom: 8px; line-height: 1.8; }
    @media (max-width: 760px) {
      .crumb { display: none; }
      .level-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .pc-points { gap: 5px; }
      .key-table { min-width: 620px; }
    }
  </style>
</Base>
