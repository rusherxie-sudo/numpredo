---
import Base from '../../layouts/Base.astro';
import SudokuGame from '../../components/SudokuGame.astro';
import { LEVELS } from '../../data/levels.ts';

const mobileLevel = LEVELS.find((level) => level.slug === 'intermediate');
if (!mobileLevel) throw new Error('中級問題が見つかりません');

const title = 'スマホで無料ナンプレ｜ダウンロード不要の数独ゲーム - numpredo';
const description = 'スマホで無料ナンプレを今すぐプレイ。アプリのダウンロード・登録不要で、縦画面のタッチ操作、候補メモ、ヒント、途中保存に対応したブラウザ版数独です。';
const url = 'https://numpredo.com/play/mobile/';
const faq = [
  {
    q: 'ナンプレのアプリをダウンロードしなくても遊べますか？',
    a: 'はい。このページはスマホのブラウザだけで遊べます。アプリのインストール、会員登録、メールアドレスの入力は不要です。',
  },
  {
    q: 'iPhoneとAndroidの両方で使えますか？',
    a: 'はい。JavaScriptが有効な一般的なブラウザであれば、iPhoneとAndroidのどちらでも利用できます。',
  },
  {
    q: '画面が小さくても数字を入力できますか？',
    a: 'はい。縦画面では盤面の下に1〜9の数字ボタンを一列で表示します。マスをタップしてから数字を選ぶだけで入力できます。',
  },
  {
    q: '通信が切れても途中から続けられますか？',
    a: 'ページを開いたままであれば、通信が切れてもそのまま遊べます。進行状況は同じブラウザの端末内に保存されますが、ページを閉じた後に再び開く際は通信が必要です。',
  },
  {
    q: 'スマホで新聞のナンプレを撮影して答え合わせできますか？',
    a: 'はい。<a href="/tools/solver/">写真対応の無料ナンプレ自動解答</a>で盤面を撮影すると、読み取った数字を確認して答えを表示できます。',
  },
];
const abs = (html: string): string => html.replace(/href="\//g, 'href="https://numpredo.com/');
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'スマホ版 無料ナンプレ・数独ゲーム',
  description,
  url,
  applicationCategory: 'GameApplication',
  operatingSystem: 'iOS, Android',
  browserRequirements: 'JavaScript対応のモバイルウェブブラウザ',
  inLanguage: 'ja',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
  publisher: { '@id': 'https://numpredo.com/#organization' },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: abs(item.a) },
  })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://numpredo.com/' },
    { '@type': 'ListItem', position: 2, name: 'プレイ', item: 'https://numpredo.com/play/' },
    { '@type': 'ListItem', position: 3, name: 'スマホ版', item: url },
  ],
};
---

<Base title={title} description={description} canonical={url} wide>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <div class="mobile-copy">
    <nav class="crumb"><a href="/">ホーム</a> › <a href="/play/">無料ゲーム</a> › スマホ版</nav>
    <h1>スマホで無料ナンプレ｜ダウンロード不要の数独ゲーム</h1>
    <p class="lead">アプリも登録も不要。縦画面で押しやすい数字ボタンを使い、中級ナンプレをすぐに遊べます。すべて唯一解で、当てずっぽうなしに論理だけで解ける検証済み問題です。</p>
    <div class="mobile-points" aria-label="スマホ版の特徴">
      <span>無料・登録不要</span><span>ダウンロード不要</span><span>片手でタップ入力</span><span>途中保存</span>
    </div>
    <p class="jump"><a href="#mobile-game">今すぐスマホでナンプレを遊ぶ</a></p>
  </div>

  <div id="mobile-game">
    <SudokuGame
      level="mobile-intermediate"
      levelJa="スマホ版・中級"
      url={url}
      set={mobileLevel.puzzles.slice(0, 30).map((p) => ({ puzzle: p.puzzle }))}
    />
  </div>

  <div class="mobile-copy">
    <section>
      <h2>スマホでナンプレを入力する方法</h2>
      <ol>
        <li><strong>空いているマスをタップ：</strong>選んだマスと同じ行・列・3×3のブロックが色で分かります。</li>
        <li><strong>盤面の下にある1〜9をタップ：</strong>確定した数字が入ります。数字ボタンの小さな表示は残りの個数です。</li>
        <li><strong>候補は「メモ」をオン：</strong>まだ一つに決められないマスには複数の候補を残せます。メモ中は選択マスが点線で表示されます。</li>
        <li><strong>入力ミスは「元に戻す」：</strong>直前の操作を取り消せます。「間違いを赤く表示」をオンにすると、正解と異なる入力もその場で確認できます。</li>
      </ol>
    </section>

    <section>
      <h2>縦画面で遊びやすくするコツ</h2>
      <p>スマホでは縦向きがおすすめです。盤面の横幅を画面に合わせ、数字ボタンを盤面のすぐ下に一列で配置するため、指の移動を少なくできます。盤面が小さく感じるときは、ブラウザの文字サイズではなく端末を縦向きに戻してください。</p>
      <p>長い問題は一度に解き切らなくても大丈夫です。同じ端末・同じブラウザなら進行状況を端末内に保存するため、ページを離れても続きを再開できます。プライベートブラウズやサイトデータ削除を使うと保存内容は消えます。</p>
    </section>

    <section>
      <h2>難易度を選んで無料で遊ぶ</h2>
      <p>このページは中級から始まります。初めてなら初級、候補メモに慣れている方は上級以上がおすすめです。すべての難易度がスマホのタッチ操作に対応しています。</p>
      <div class="level-grid">
        {LEVELS.map((level) => (
          <a href={`/play/${level.slug}/`}><strong>{level.ja}</strong><span>{level.en}</span></a>
        ))}
      </div>
    </section>

    <section>
      <h2>アプリ版ではなくブラウザ版を使う利点</h2>
      <p>ストアを開いたり、端末の空き容量を使ってアプリを追加したりせず、このURLを開くだけで始められます。会員登録も広告を見るための操作も必要ありません。端末を共有している場合は、同じブラウザに進行状況が残る点だけご注意ください。</p>
      <p>毎日違う問題なら<a href="/daily/">日替わりナンプレ5問</a>、紙の問題をスマホで読み取るなら<a href="/tools/solver/">写真対応の自動解答ソルバー</a>へ。大画面とキーボードで遊ぶ方には<a href="/play/pc/">パソコン版の無料ナンプレ</a>もあります。</p>
    </section>

    <section>
      <h2>よくある質問</h2>
      <dl class="faq">
        {faq.map((item) => <><dt>{item.q}</dt><dd set:html={item.a} /></>)}
      </dl>
    </section>
  </div>

  <style>
    .mobile-copy { max-width: 1060px; margin: 0 auto; }
    .crumb { margin-bottom: 10px; color: var(--ink-3); font-size: var(--text-xs); }
    .crumb a { color: var(--ink-3); text-decoration: none; }
    .lead { max-width: 820px; color: var(--ink-2); line-height: 1.85; }
    .mobile-points { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0; }
    .mobile-points span { padding: 5px 11px; border: 1px solid var(--line-2); border-radius: var(--radius-pill); background: var(--surface-2); color: var(--ink-2); font-size: var(--text-sm); }
    .jump { margin: 14px 0 20px; }
    .jump a { display: inline-block; padding: 10px 18px; border-radius: var(--radius-sm); background: var(--accent); color: var(--accent-on); font-weight: 700; text-decoration: none; }
    .level-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }
    .level-grid a { display: flex; flex-direction: column; gap: 3px; padding: 12px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); color: var(--ink); text-align: center; text-decoration: none; }
    .level-grid a:hover { border-color: var(--accent); }
    .level-grid span { color: var(--ink-3); font-size: var(--text-xs); }
    .faq dt { margin-top: 16px; font-family: var(--font-mincho); font-weight: 700; }
    .faq dd { margin: 5px 0 0; color: var(--ink-3); line-height: 1.8; }
    .faq a, section a { color: var(--accent); }
    section { margin-top: 30px; }
    section li { margin-bottom: 8px; line-height: 1.8; }
    @media (max-width: 760px) {
      .crumb { display: none; }
      .level-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .mobile-points { gap: 5px; }
    }
  </style>
</Base>
