---
import Base from '../../layouts/Base.astro';
import SudokuGame from '../../components/SudokuGame.astro';
import { LEVELS } from '../../data/levels.ts';
// 収録総数は題庫から実測（「問題集」系クエリの受け皿：数字は本物、扩库自動追随）
const totalPuzzles = LEVELS.reduce((s, l) => s + l.puzzles.length, 0);
const title = `数独無料ゲーム・ナンプレ問題集｜全${totalPuzzles}問 - numpredo`;
const description = `初級から超難問まで全${totalPuzzles}問収録の無料数独（ナンプレ）問題集。難易度別にオンラインでプレイでき、すべて唯一解・論理だけで解ける検証済みの高品質問題。図解つき解説・印刷にも対応、登録不要でスマホでも遊べます。`;
const url = 'https://numpredo.com/play/';
const featuredLevel = LEVELS.find((l) => l.slug === 'intermediate') ?? LEVELS[0];
const featuredSet = featuredLevel.puzzles.slice(0, 12).map((p) => ({ puzzle: p.puzzle }));

// 難易度比較表：ヒント数は題庫全量から実測平均（構築期に計算、データと乖離しない）
// SETS = play/[level]/[n].astro の SETS_PER_LEVEL と同値（日次で増加）
const EPOCH_MS = Date.UTC(2026, 5, 14);
const JST = 9 * 3600 * 1000;
const todayIdx = Math.floor((Date.now() + JST) / 86400000);
const epochIdx = Math.floor(EPOCH_MS / 86400000);
const elapsedDays = Math.max(0, todayIdx - epochIdx - 1);
const SETS = 55 + elapsedDays;
const SHORT_TECH: Record<string, string> = {
  beginner: '裸の単数・隠れた単数',
  intermediate: '区画の絞り込み',
  advanced: 'ペア（二国同盟）',
  hard: '三国同盟（ネイキッドトリプル）',
  extreme: 'スカイスクレイパー・X-Wingなど',
};
// 空マスは題庫 JSON で '.'（gridToString 出力）——数字だけを数える（'0' 表記にも頑健）
const avgClues = (puzzles: Array<{ puzzle: string }>): number =>
  Math.round(puzzles.reduce((s, p) => s + [...p.puzzle].filter((c) => c >= '1' && c <= '9').length, 0) / puzzles.length);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://numpredo.com/' },
    { '@type': 'ListItem', position: 2, name: 'プレイ', item: url },
  ],
};
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '数独・ナンプレの難易度一覧',
  itemListElement: LEVELS.map((l, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${l.ja}の数独・ナンプレ`,
    url: `https://numpredo.com/play/${l.slug}/`,
  })),
};
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '無料の数独・ナンプレゲーム',
  description,
  url,
  applicationCategory: 'GameApplication',
  operatingSystem: 'Web',
  inLanguage: 'ja',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
  publisher: { '@id': 'https://numpredo.com/#organization' },
};
const faq = [
  { q: '数独無料ゲームは登録なしで遊べますか？', a: 'はい。初級・中級・上級・難問・超難問の5段階を、登録もダウンロードも不要で遊べます。候補メモ、ヒント、自動チェック、途中保存も無料です。' },
  { q: '数独の中級と上級は何が違いますか？', a: '中級は主に区画の絞り込み、上級はさらにペア（二国同盟）を使います。中級が安定して解けるようになったら上級へ進むのがおすすめです。' },
  { q: '上級・難問・超難問の違いは？', a: '上級はペア、難問は三国同盟など複数候補の整理、超難問はX-Wingやスカイスクレイパーなど複数の行・列をまたぐテクニックが目安です。空きマスの数ではなく、必要な解法で分類しています。' },
  { q: '無料の数独問題集を印刷できますか？', a: 'はい。印刷ページでは初級から超難問まで、2問・4問・6問・12問の答え付き問題集を作成し、A4印刷またはPDF保存できます。' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base title={title} description={description} canonical={url} wide>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <nav class="crumb"><a href="/">ホーム</a> › プレイ</nav>
  <h1>数独・ナンプレ無料ゲーム｜今すぐオンラインでプレイ</h1>
  <p class="lead">登録・ダウンロード不要。まずは人気の中級をそのままプレイできます。全{totalPuzzles}問、すべて唯一解・論理だけで解けることを検証済みです。</p>

  <div class="featured-game-head">
    <p><strong>人気の中級問題</strong>を出題中。ヒント・候補メモ・途中保存に対応しています。</p>
    <a href="/play/beginner/">初級に変える</a>
  </div>
  <SudokuGame level="intermediate" levelJa="中級" url={url} set={featuredSet} />

  <h2>難易度を選んでプレイ</h2>
  <div class="play-list">
    {LEVELS.map((l) => (
      <a href={`/play/${l.slug}/`} class="play-card">
        <span class="pc-j">{l.ja}<span class="pc-e">（{l.en}）</span></span>
        <span class="pc-d">{l.lead}</span>
      </a>
    ))}
  </div>

  <h2>難易度の比較（早見表）</h2>
  <p class="lead">どの難易度から始めるか迷ったら。必要なテクニックとヒント数のめやすで選べます。</p>
  <div class="gtable-wrap">
    <table class="gtable">
      <thead><tr><th>難易度</th><th>解くのに必要な主なテクニック</th><th>ヒント数（平均）</th><th>収録問題数</th><th>印刷</th></tr></thead>
      <tbody>
        {LEVELS.map((l) => (
          <tr>
            <td><a href={`/play/${l.slug}/`}>{l.ja}（{l.en}）</a></td>
            <td>{SHORT_TECH[l.slug]}</td>
            <td>約{avgClues(l.puzzles)}個</td>
            <td>{l.puzzles.length}問</td>
            <td><a href={`/print/${l.slug}/`}>{l.ja}の答え付きPDF</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="tnote">※ ブラウザでの出題は各難易度{SETS}問を順繰りに、<a href="/print/">印刷ページ</a>では収録全問からランダムに出題します。</p>

  <h2>中級・上級・難問・超難問は何が違う？</h2>
  <p><a href="/play/intermediate/"><strong>数独無料ゲームの中級</strong></a>は、区画の絞り込みを覚える段階です。中級がすらすら解けるようになったら、ペア（二国同盟）を使う<a href="/play/advanced/"><strong>上級の数独無料ゲーム</strong></a>へ。さらに三国同盟などを組み合わせる<a href="/play/hard/"><strong>難問ナンプレ</strong></a>、X-Wing・スカイスクレイパー級の<a href="/play/extreme/"><strong>最上級・超難問の数独</strong></a>と進みます。</p>
  <p>numpredo の難易度はヒント数の少なさではなく、解くために必要な最難テクニックで判定しています。どの段階も唯一解で、当てずっぽうを使わず論理だけで最後まで解けます。</p>

  <h2>問題集・一手ずつ図解で解き方</h2>
  <p class="lead">各難易度の問題を、解答エンジンの手順どおりに一手ずつ図解。詰まったときの「次の一手」と、その難易度で使うテクニックがわかります。</p>
  <ul>
    {LEVELS.map((l) => <li><a href={`/play/${l.slug}/1/`}>数独{l.ja}の問題を図解で解く（No.1〜{SETS}）</a></li>)}
  </ul>

  <h2>バリエーション数独</h2>
  <ul>
    <li><a href="/variants/killer/">キラー数独</a> — ケージの合計から解く【プレイできます】</li>
    <li><a href="/variants/6x6/">6×6数独（ミニ数独）</a> — 1〜6だけの入門向け</li>
    <li><a href="/variants/16x16/">16×16数独（ナンプレ16）</a> — 1〜9とA〜Gで解く大型盤面</li>
    <li><a href="/variants/inequality/">不等号ナンプレの解き方・コツ</a> — 大小関係で絞り込む</li>
    <li><a href="/variants/diagonal/">対角線数独（X数独）</a> — 対角線にも1〜9を入れる【プレイできます】</li>
  </ul>

  <h2>端末に合った無料ナンプレ</h2>
  <ul>
    <li><a href="/play/mobile/"><strong>スマホ版の無料ナンプレ</strong></a> — ダウンロード不要。縦画面のタッチ操作と一列の数字ボタンで遊べます。</li>
    <li><a href="/play/pc/"><strong>パソコン版の無料ナンプレ</strong></a> — インストール不要。矢印キー、数字キー、Delete、Ctrl+Zで操作できます。</li>
  </ul>

  <h2>学ぶ・印刷する</h2>
  <ul>
    <li><a href="/guide/how-to-solve/">数独・ナンプレの解き方ガイド</a></li>
    <li><a href="/print/">無料PDF問題集（印刷）</a></li>
    <li><a href="/daily/">毎日の数独</a></li>
  </ul>

  <h2>数独無料ゲームについてよくある質問</h2>
  <dl class="faq">{faq.map((f) => (<><dt>{f.q}</dt><dd>{f.a}</dd></>))}</dl>

  <style is:global>
    .crumb { font-size: 12px; color: var(--ink-3); margin-bottom: 10px; }
    .crumb a { color: var(--ink-3); text-decoration: none; }
    .lead { color: var(--ink-3); font-size: 14px; margin: 0 0 18px; }
    .featured-game-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 0 auto 8px; max-width: 880px; }
    .featured-game-head p { margin: 0; color: var(--ink-3); font-size: 13px; }
    .featured-game-head a { color: var(--accent); font-size: 13px; white-space: nowrap; }
    main ul { line-height: 2; } main ul a { color: var(--accent); }
    .play-list { display: flex; flex-direction: column; gap: 10px; }
    .play-card { display: block; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 16px 18px; text-decoration: none; color: var(--ink); transition: border-color 0.12s; }
    .play-card:hover { border-color: var(--accent); }
    .pc-j { font-family: var(--font-mincho); font-size: 17px; font-weight: 600; }
    .pc-e { font-size: 12px; color: var(--ink-3); font-weight: 400; }
    .pc-d { display: block; font-size: 13px; color: var(--ink-3); margin-top: 4px; }
    .gtable-wrap { overflow-x: auto; margin: 10px 0 4px; }
    .gtable { width: 100%; border-collapse: collapse; font-size: 14px; }
    .gtable th, .gtable td { border: 1px solid var(--line-2); padding: 8px 11px; text-align: left; vertical-align: top; }
    .gtable th { background: var(--surface-2); font-weight: 700; color: var(--ink); }
    .gtable td:first-child { white-space: nowrap; }
    .tnote { font-size: 12px; color: var(--ink-4); margin: 6px 0 0; }
    .faq dt { font-family: var(--font-mincho); font-weight: 600; margin-top: 16px; }
    .faq dd { margin: 5px 0 0; color: var(--ink-3); }
    @media (max-width: 560px) {
      .featured-game-head { align-items: flex-start; }
    }
  </style>
</Base>
